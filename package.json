{
  "name": "@ice/lite-scaffold",
  "version": "1.3.0",
  "description": "A new ice.js project.",
  "dependencies": {
    "@ice/runtime": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^8.5.2",
    "react-router-dom": "^6.21.3"
  },
  "devDependencies": {
    "@applint/spec": "^1.2.3",
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@ice/app": "^3.4.0",
    "@types/node": "^18.11.17",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "babel-loader": "^9.2.1",
    "css-loader": "^6.11.0",
    "egg": "^3.34.0",
    "egg-bin": "^5.19.0",
    "eslint": "^8.35.0",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.50.0",
    "sass-loader": "^14.2.1",
    "stylelint": "^15.2.0",
    "typescript": "^4.9.5",
    "webpack": "^5.113.0",
    "webpack-cli": "^5.1.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3"
  },
  "scripts": {
    "start": "npm run build && npm run server",
    "build": "node -e \"const f=require('fs');f.rmSync('dist',{recursive:true,force:true});f.mkdirSync('dist');f.copyFileSync('public/favicon.ico','dist/favicon.ico')\" && webpack",
    "build:watch": "webpack --watch",
    "dev": "node scripts/dev.js",
    "build:ice": "ice build",
    "dev:ice": "ice start --speedup",
    "server": "egg-bin dev --baseDir=./server",
    "server:prod": "node server/server.js",
    "eslint": "eslint ./src --cache --ext .js,.jsx,.ts,.tsx",
    "eslint:fix": "npm run eslint -- --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss,less}\" --cache",
    "stylelint:fix": "npm run stylelint -- --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": "git@github.com:ice-lab/react-materials.git"
}
